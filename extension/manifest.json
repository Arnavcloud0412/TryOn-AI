{
  "manifest_version": 3,
  "name": "TryOn AI - Virtual Fitting Room",
  "short_name": "TryOn AI",
  "version": "1.0.0",
  "description": "Create your digital body profile once, then virtually try on clothes, shoes and accessories from any shopping website.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open TryOn AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "scripting", "activeTab", "contextMenus", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' blob: data: https: http:"
  }
}
